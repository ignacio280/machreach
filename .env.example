# OpenAI API key (for email generation)
OPENAI_API_KEY=sk-your-key-here

# Gmail SMTP (or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# App
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY=change-me-to-a-different-stable-random-string
DATABASE_PATH=data/machreach.db
# Production uses Postgres instead (any libpq URL; the VPS stack in deploy/
# builds it from POSTGRES_PASSWORD). Leave unset locally to use SQLite.
#DATABASE_URL=
# Required in production until the first database administrator enrolls MFA.
ADMIN_ACTION_SECRET=change-me-to-a-long-random-deployment-secret
# Required for authenticated access to /health/operations.
OPERATIONS_SECRET=change-me-to-a-different-long-random-secret
# Keep production diagnostics disabled unless you explicitly need them.
ENABLE_DEBUG_ENDPOINTS=0
# Production should use a shared Redis/Valkey backend, e.g. Render Key Value's internal redis:// URL.
RATELIMIT_STORAGE_URI=memory://
ACADEMIC_UNIVERSITY_CHANGE_COOLDOWN_DAYS=30
AI_ESTIMATED_INPUT_USD_PER_MILLION=0.15
AI_ESTIMATED_OUTPUT_USD_PER_MILLION=0.60

# Lemon Squeezy. Billing remains disabled unless the store, product, and
# variant identifiers for a checkout are all configured.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LS_PRODUCT_STUDENT_PLUS=
LS_VARIANT_STUDENT_PLUS=
LS_PRODUCT_COIN_SMALL=
LS_VARIANT_COIN_SMALL=
LS_PRODUCT_COIN_MEDIUM=
LS_VARIANT_COIN_MEDIUM=
LS_PRODUCT_COIN_LARGE=
LS_VARIANT_COIN_LARGE=
LS_PRODUCT_COIN_MEGA=
LS_VARIANT_COIN_MEGA=
LS_PRODUCT_COIN_ULTRA=
LS_VARIANT_COIN_ULTRA=

# Tracking (your server's public URL for open tracking pixels)
BASE_URL=http://localhost:5000
