# OpenAI API key (for email generation)
OPENAI_API_KEY=sk-your-key-here

# Gmail SMTP (or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# App
SECRET_KEY=change-me-to-a-random-string
DATABASE_PATH=data/outreach.db
ADMIN_EMAILS=ignaciomachuca2005@gmail.com,fernanda.machuca@uc.cl
# Keep production diagnostics disabled unless you explicitly need them.
ENABLE_DEBUG_ENDPOINTS=0
# Optional shared rate-limit backend for production scale, e.g. redis://...
RATELIMIT_STORAGE_URI=memory://

# Tracking (your server's public URL for open tracking pixels)
BASE_URL=http://localhost:5000
