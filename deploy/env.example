# Copy to deploy/.env on the server (the bootstrap does this from cloud-init).
# One file feeds both docker compose (POSTGRES_PASSWORD, SITE_DOMAIN, the
# optional RENDER_DATABASE_URL) and the app containers (everything else).
# Never commit the real file.

# --- Server ------------------------------------------------------------------
SITE_DOMAIN=machreach.com
# Any long random string; only the containers ever see it.
POSTGRES_PASSWORD=change-me-long-random
# Render's EXTERNAL Postgres connection string. When set, the bootstrap copies
# the database from it, and `machreach-cutover` copies it again at cutover.
# Remove it after the Render database is deleted.
RENDER_DATABASE_URL=

# --- App (same names and values as the Render environment) -------------------
SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_ACTION_SECRET=
OPERATIONS_SECRET=
BASE_URL=https://machreach.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OPENAI_API_KEY=
AI_PLUS_MONTHLY_LIMIT=100
AI_USER_DAILY_MAX=120
AI_GLOBAL_DAILY_MAX=5000
AI_USER_DAILY_TOKEN_MAX=1000000
AI_GLOBAL_DAILY_TOKEN_MAX=25000000
AI_ESTIMATED_INPUT_USD_PER_MILLION=0.15
AI_ESTIMATED_OUTPUT_USD_PER_MILLION=0.60
REFERRAL_REWARD_30D_MAX=20
ACADEMIC_UNIVERSITY_CHANGE_COOLDOWN_DAYS=30
RATELIMIT_STORAGE_URI=memory://
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=false
LS_PRODUCT_STUDENT_PLUS=
LS_VARIANT_STUDENT_PLUS=
LS_PRODUCT_COIN_SMALL=
LS_VARIANT_COIN_SMALL=
LS_PRODUCT_COIN_MEDIUM=
LS_VARIANT_COIN_MEDIUM=
LS_PRODUCT_COIN_LARGE=
LS_VARIANT_COIN_LARGE=
LS_PRODUCT_COIN_MEGA=
LS_VARIANT_COIN_MEGA=
LS_PRODUCT_COIN_ULTRA=
LS_VARIANT_COIN_ULTRA=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
LEADERBOARD_WINNERS_RECIPIENT=
